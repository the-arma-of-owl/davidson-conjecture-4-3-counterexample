import DavidsonLean.Criterion
import DavidsonLean.Prop3
import DavidsonLean.Poly

/-!
# The main theorem: `Γ_α` is not 3-colourable

`Γ_α = Cay(ℤ[α], {±α^n : n ≥ 0})`.  The vertex set is `ℤ[α] = Algebra.adjoin ℤ {α} ⊆ ℂ`
(the subring of `ℂ` generated by `α`); two vertices `z ≠ w` are adjacent iff `w - z = ±α^n`
for some `n ≥ 0`.

Proof (paper, §4 "Proof of the Theorem"): a 3-colouring `C` of `Γ_α` gives the grid colouring
`c(v) = C(∑_{i<80} v_i α^i)` of `ℤ^80`, which is proper (adjacent grid points map to adjacent
vertices) and invariant under the coefficient vectors `ℓ_j` of `x^j f`, since
`∑ (ℓ_j)_i α^i = α^j f(α) = 0`.  Lemma 2 (`lemma2`, `K = 79`) then produces a `σ` that
Proposition 3 (`prop3`) rules out.
-/

namespace Davidson

open Polynomial

/-- `Γ_α = Cay(ℤ[α], {±α^n : n ≥ 0})`, with vertex set `ℤ[α] = Algebra.adjoin ℤ {α} ⊆ ℂ`. -/
def Gamma (α : ℂ) : SimpleGraph (Algebra.adjoin ℤ ({α} : Set ℂ)) where
  Adj z w := z ≠ w ∧ ∃ n : ℕ, (w : ℂ) - z = α ^ n ∨ (z : ℂ) - w = α ^ n
  symm := ⟨fun _ _ ⟨h, n, hn⟩ => ⟨h.symm, n, hn.symm⟩⟩
  loopless := ⟨fun _ h => h.1 rfl⟩

section bridge

variable (α : ℂ)

lemma pow_mem_adjoin (i : ℕ) : α ^ i ∈ Algebra.adjoin ℤ ({α} : Set ℂ) :=
  Subalgebra.pow_mem _ (Algebra.subset_adjoin rfl) i

/-- the grid point `v ∈ ℤ^{K+1}` as the vertex `∑ v_i α^i` of `Γ_α` -/
noncomputable def toVertex {K : ℕ} (v : Fin (K + 1) → ℤ) : Algebra.adjoin ℤ ({α} : Set ℂ) :=
  ⟨∑ i, (v i : ℂ) * α ^ (i : ℕ),
    Subalgebra.sum_mem _ (fun i _ => Subalgebra.mul_mem _ (intCast_mem _ _) (pow_mem_adjoin α i))⟩

lemma toVertex_val {K : ℕ} (v : Fin (K + 1) → ℤ) :
    (toVertex α v : ℂ) = ∑ i, (v i : ℂ) * α ^ (i : ℕ) := rfl

lemma toVertex_add {K : ℕ} (v u : Fin (K + 1) → ℤ) :
    (toVertex α (v + u) : ℂ) = toVertex α v + toVertex α u := by
  simp only [toVertex_val, Pi.add_apply, Int.cast_add, add_mul, Finset.sum_add_distrib]

lemma toVertex_single {K : ℕ} (n : Fin (K + 1)) :
    (toVertex α (Pi.single n 1) : ℂ) = α ^ (n : ℕ) := by
  rw [toVertex_val, Finset.sum_eq_single n (fun b _ hb => by simp [hb])
    (by simp)]
  simp

lemma toVertex_ell (hα : aeval α Poly.f = 0) {K : ℕ} (j : ℕ) (hj : j + 12 ≤ K) :
    (toVertex α (ell K j) : ℂ) = 0 := by
  rw [toVertex_val, ell_sum K j hj (fun i => α ^ (i : ℕ))]
  have hf : aeval α Poly.f = ∑ k : Fin 13, (a k : ℂ) * α ^ (k : ℕ) := by
    simp [Poly.f_eq_sum, map_sum]
  have : ∑ k : Fin 13, (a k : ℂ) * α ^ (k.val + j) = α ^ j * aeval α Poly.f := by
    rw [hf, Finset.mul_sum]
    refine Finset.sum_congr rfl (fun k _ => ?_)
    rw [pow_add]; ring
  rw [this, hα, mul_zero]

end bridge

/-- **Main theorem (lower bound).** For every root `α` of
`f = 2x^12+2x^11+x^10-x^9-2x^8-x^7-x^6-x^5-2x^4-x^3+x^2+2x+2`, the graph
`Γ_α = Cay(ℤ[α], {±α^n : n ≥ 0})` is not 3-colourable. -/
theorem gamma_not_colorable (α : ℂ) (hα : aeval α Poly.f = 0) : ¬ (Gamma α).Colorable 3 := by
  rintro ⟨C⟩
  have hα0 : α ≠ 0 := by
    intro h0
    have := (Poly.roots_on_circle α hα).1
    rw [h0, norm_zero] at this
    exact zero_ne_one this
  let c : (Fin (79 + 1) → ℤ) → ZMod 3 := fun v => (C (toVertex α v) : ZMod 3)
  have hproper : ∀ v (n : Fin (79 + 1)), c (v + Pi.single n 1) ≠ c v := by
    intro v n
    have hval : (toVertex α (v + Pi.single n 1) : ℂ) - toVertex α v = α ^ (n : ℕ) := by
      rw [toVertex_add, toVertex_single]; ring
    have hadj : (Gamma α).Adj (toVertex α v) (toVertex α (v + Pi.single n 1)) := by
      refine ⟨fun h => ?_, n, Or.inl hval⟩
      rw [h, sub_self] at hval
      exact pow_ne_zero _ hα0 hval.symm
    exact fun h => C.valid hadj h.symm
  have hper : ∀ v (j : Fin (79 - 11)), c (v + ell 79 j) = c v := by
    intro v j
    have : toVertex α (v + ell 79 j) = toVertex α v := by
      apply Subtype.ext
      rw [toVertex_add, toVertex_ell α hα j (by omega), add_zero]
    exact congrArg (fun z => (C z : ZMod 3)) this
  obtain ⟨σ, hσ1, hσ2⟩ := lemma2 79 c hproper hper
  exact prop3 ⟨σ, hσ1, hσ2⟩

/-- Equivalent form: `χ(Γ_α) ≥ 4`. -/
theorem four_le_chromaticNumber (α : ℂ) (hα : aeval α Poly.f = 0) :
    4 ≤ (Gamma α).chromaticNumber := by
  by_contra h
  rw [not_le] at h
  apply gamma_not_colorable α hα
  rw [← SimpleGraph.chromaticNumber_le_iff_colorable]
  exact Order.le_of_lt_add_one h

end Davidson

#print axioms Davidson.lemma2
#print axioms Davidson.gamma_not_colorable
#print axioms Davidson.four_le_chromaticNumber
